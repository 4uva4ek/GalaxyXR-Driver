/* TypeScript config for the Lit/Fluent frontend (2026-09-20 migration).
 * Replaces the Angular base config; the old tsconfig.app.json / tsconfig.spec.json
 * are removed at cutover. `tsc --noEmit` is the type-check gate of `npm run build:ui`;
 * Vite/esbuild do the actual transpilation (esbuild strips types, it does not check).
 * Decorators: Lit's lit/decorators.js under legacy (experimental) decorators with
 * assignment semantics, so instance fields do not shadow Lit reactive accessors.
 */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "moduleResolution": "bundler",
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "noEmit": true
  },
  "include": [
    "src-lit/**/*.ts",
    "src/environment.ts",
    "src/environment-gen.ts"
  ]
}
